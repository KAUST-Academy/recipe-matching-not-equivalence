#!/bin/bash
#SBATCH --job-name=dose-response
#SBATCH --time=24:00:00
#SBATCH --gres=gpu:a100:1
#SBATCH --mem=128G
#SBATCH --cpus-per-task=10
#SBATCH --output=/ibex/user/habiam0b/MathNet_Follow_Up/results/slurm_%x_%j.out
#SBATCH --error=/ibex/user/habiam0b/MathNet_Follow_Up/results/slurm_%x_%j.err

# ============================================================================
# PROMPT-PROXIMITY DOSE-RESPONSE (the paper's mechanism centerpiece).
#
# The external-OOD sweep (job 49589999) showed the LLM-arm advantage forms a
# RECIPE-PROXIMITY GRADIENT across evals (MathNet-hard 66x -> MELD 2x ->
# real-duplicates ~0 -> BRIGHT negative). This job builds the same gradient
# WITHIN the training side: four dose points of training data at increasing
# prompt distance from the benchmark's own Appendix-F generation recipe,
# everything else held fixed (generator Qwen3-32B-AWQ, judge pass, source ids
# data/phase2/cas_source_ids.txt [7,089], generation seed 0, training seed 42,
# exact controlled-experiment hyperparameters, --max-rows 6145).
#
#   D1 exact       Appendix-F prompt verbatim      = ALREADY EXISTS
#                  (data/llm_pairs/pairs.jsonl, models/ctrl-llm-6145;
#                  NEVER regenerated by this job — reference rows only)
#   D2 paraphrase  semantic paraphrase of Appendix-F (same task, same
#                  1-pos/3-neg structure, different words/structure)
#   D3 style       same goal in a genuinely different authorial framing
#                  (competition coach assembling a worksheet: "disguises"
#                  and "traps", conversational voice, no transformation menu)
#   D4 unrelated   equivalence-preserving augmentation OUTSIDE the recipe
#                  (audience-level restatement; positives only — see honesty
#                  notes below)
# Verbatim prompts: scripts/generate_llm_pairs.py (GEN_SYSTEM = D1,
# GEN_SYSTEM_PARAPHRASE/STYLE/UNRELATED = D2/D3/D4); dumped per-variant by
# this job into results/dose_dryrun_{variant}.txt.
#
# ---------------------------------------------------------------------------
# PRE-REGISTERED PREDICTIONS (written 2026-07-30, BEFORE any D2-D4 data or
# model existed; D1/ctrl references were already measured):
#  LABEL SCHEME (renamed 2026-08-23, content unchanged): this registration's
#  predictions were originally written as P1..Pn. They are now namespaced
#  P-L* because three registrations (SABER, MELD, dose ladder) each used
#  P1/P2. The renaming is 1:1 and changes no threshold, clause or verdict;
#  git history preserves the original labels.
#  P-L1 dose-response decay: benchmark gains over the untrained base decay
#     MONOTONICALLY with prompt distance from the recipe —
#       hard R@1 delta over base: D1 (+9.37) > D2 > D3 > D4 (primary)
#       easy R@1 delta over base: D1 (+53.56) > D2 > D3 > D4 (secondary)
#     (references, all pre-measured: D1 = ctrl-llm-6145 61.88 easy / 9.37
#     hard R@1; ctrl-cas 17.31 / 0.13; base 0.6B 8.32 / 0.00.)
#  P-L2 flat real-duplicate line: all four dose points stay in the trained-arm
#     band on real-duplicate strict R@1 — below base 84.73, spread across
#     D1-D4 <= 10 points, with NO monotone trend tracking the dose. The dose
#     moves benchmark numbers only; real equivalence ability is unchanged
#     (beyond the generic forgetting erosion every narrow arm shows).
#  FALSIFIER (stated in advance): if D4 — whose prompt shares nothing with
#     the benchmark recipe beyond "produce an equivalent math problem" —
#     gains >= 50% of D1's hard-tier delta over base (i.e. hard R@1 >= ~4.69),
#     the recipe-proximity mechanism is REFUTED: the benchmark advantage
#     would be a generic property of LLM equivalence rewrites, not proximity
#     to the generation recipe, and the paper must say so. Partial outcomes
#     (e.g. D2/D3 swap order while D1 >> D4 holds) weaken the claim from
#     "monotone gradient" to "endpoint gradient". Report either way.
#
# DESIGN HONESTY NOTES (carry into the paper):
#  * D1-D3 share the strict-JSON output contract (identical keys — they are
#    the script's parsing interface) and the 1-pos/3-neg structure; only the
#    instructional/framing text varies. The judge pass is byte-identical for
#    all four points.
#  * D4 removes the near-miss channel ITSELF: positives only, judged like
#    all others, but trainer rows carry ZERO attached negatives (in-batch
#    negatives only under CMNRL), vs ~2.6 judge-accepted near-misses/row for
#    D1-D3. Its drop therefore conflates prompt distance with negative
#    sourcing — D4 is the recipe-UNRELATED endpoint, not a pure prompt
#    manipulation. Any D4 interpretation must carry this asymmetry.
#  * Row budgets: every arm trains with --max-rows 6145 (the D1 count). If
#    an arm produces materially fewer verified rows, the summary flags it
#    (>10% under budget = budget-mismatched; interpret with caution).
#
# RUNTIME (honest estimate; measured anchors in parentheses):
#  generation D2+D3 ~2.5 h each, D4 ~1-1.5 h (D1 full job: 2h33m incl. load;
#  D4 has ~7.1K judge calls vs ~28.4K), + 3 smokes ~20 min each
#    => gen stage ~7-9.5 h (6 vLLM model loads at ~10-15 min each included)
#  training 3 x ~1.6 h (ctrl arms took ~45 min/arm + evals in a 1h38m job)
#    => ~5 h;  evals 3 x ~15 min (easy+hard share the per-model emb cache)
#    + xling 3 x ~4 min  => ~1 h
#  TOTAL ~13-15 h  =>  24 h cap has >1.5x slack.
#
# Submit:  sbatch scripts/dose_response.slurm
# Resume-safe: full generation outputs, trained finals, and eval JSONs that
# already exist are skipped, so a requeue continues where it stopped.
# ============================================================================

set -euo pipefail

PROJECT=/ibex/user/habiam0b/MathNet_Follow_Up
GENMODEL="${GENMODEL:-Qwen/Qwen3-32B-AWQ}"
SOURCE_IDS=data/phase2/cas_source_ids.txt
VARIANTS=(paraphrase style unrelated)          # D2 D3 D4 (D1 pre-exists)
declare -A NEGS=([paraphrase]=3 [style]=3 [unrelated]=0)

source /ibex/user/habiam0b/miniconda3/etc/profile.d/conda.sh
export HF_HOME="${PROJECT}/.hf_cache"
export TOKENIZERS_PARALLELISM=false
cd "${PROJECT}"
mkdir -p data/pairs results
export FAILLOG="results/dose_response_failures_${SLURM_JOB_ID:-local}.log"
: > "${FAILLOG}"

echo "== node: $(hostname)  gpu: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader) =="
echo "== start: $(date) =="

if [[ ! -s "${SOURCE_IDS}" ]]; then
    echo "FATAL: ${SOURCE_IDS} missing — the matched-budget source list is required"
    exit 1
fi

# refuse to run over partly-trained model dirs (finished finals are skipped)
for V in "${VARIANTS[@]}"; do
    if [[ -e "models/dose-${V}-6145" && ! -e "models/dose-${V}-6145/final" ]]; then
        echo "FATAL: models/dose-${V}-6145 exists without final/ — partial run; clean up first"
        exit 1
    fi
done

# ---------------------------------------------------------------------------
# STAGE 1 — generation D2-D4 (vllm env; same env contract as
# generate_llm_pairs.slurm, incl. the cu12x fail-fast check)
# ---------------------------------------------------------------------------
conda activate vllm
python - <<'PYCHECK'
import sys
import torch, vllm
cu = torch.version.cuda or "none"
print(f"[env] vllm {vllm.__version__} | torch {torch.__version__} | cuda build {cu}")
if not cu.startswith("12."):
    sys.exit(f"FATAL: torch CUDA build {cu} is not cu12x (Ibex driver 12080 = CUDA <= 12.8)")
if not torch.cuda.is_available():
    sys.exit("FATAL: torch.cuda.is_available() is False on the GPU node")
PYCHECK
export VLLM_WORKER_MULTIPROC_METHOD=spawn
export VLLM_USE_FLASHINFER_SAMPLER=0   # no nvcc on Ibex nodes (see generate_llm_pairs.slurm)

# exact prompt texts on record (cheap, no GPU; exact dump included for diffing)
for V in exact "${VARIANTS[@]}"; do
    python scripts/generate_llm_pairs.py --dry-run --prompt-variant "${V}" \
        --num-problems 3 > "results/dose_dryrun_${V}.txt"
done

for V in "${VARIANTS[@]}"; do
    if [[ -s "data/pairs/llm_pairs_${V}.jsonl" ]]; then
        echo "== [${SECONDS}s] D-${V}: generation output exists — skipping =="
        continue
    fi
    echo "== [${SECONDS}s] D-${V}: 30-problem smoke (fails fast on prompt/JSON issues) =="
    python scripts/generate_llm_pairs.py \
        --model "${GENMODEL}" --backend vllm --seed 0 \
        --prompt-variant "${V}" --num-problems 30 \
        --positives-per-problem 1 --negatives-per-problem "${NEGS[$V]}" \
        --output "data/pairs/dose_smoke_${V}.jsonl"
    python scripts/validate_pairs_schema.py "data/pairs/dose_smoke_${V}.jsonl"
    N_SMOKE=$(wc -l < "data/pairs/dose_smoke_${V}.jsonl")
    MIN_SMOKE=$(( NEGS[$V] > 0 ? 60 : 20 ))   # ~120 expected with negs, ~30 without
    if (( N_SMOKE < MIN_SMOKE )); then
        echo "FATAL: ${V} smoke produced only ${N_SMOKE} rows (< ${MIN_SMOKE}) — prompt/JSON issue"
        exit 1
    fi

    echo "== [${SECONDS}s] D-${V}: full generation over $(wc -l < ${SOURCE_IDS}) source ids =="
    python scripts/generate_llm_pairs.py \
        --model "${GENMODEL}" --backend vllm --seed 0 \
        --prompt-variant "${V}" \
        --source-ids-file "${SOURCE_IDS}" \
        --positives-per-problem 1 --negatives-per-problem "${NEGS[$V]}" \
        --output "data/pairs/llm_pairs_${V}.jsonl" \
        --summary "results/llm_pairs_${V}_summary.json"
    python scripts/validate_pairs_schema.py "data/pairs/llm_pairs_${V}.jsonl"
done

# ---------------------------------------------------------------------------
# STAGE 2 — convert + train + eval per dose point (mathnet env)
# ---------------------------------------------------------------------------
conda activate mathnet

run_soft() {  # evals are fail-soft so one bad step cannot kill the sweep
    echo "== [${SECONDS}s] $1 =="
    shift
    if ! "$@"; then
        echo "FAILED: $*" | tee -a "${FAILLOG}"
    fi
}

for V in "${VARIANTS[@]}"; do
    echo "== [${SECONDS}s] D-${V}: convert to trainer format =="
    python scripts/convert_llm_pairs.py \
        --input "data/pairs/llm_pairs_${V}.jsonl" \
        --output "data/llm_pairs_${V}/pairs.jsonl"
    N_ROWS=$(wc -l < "data/llm_pairs_${V}/pairs.jsonl")
    if (( N_ROWS < 5530 )); then   # >10% under the 6,145 budget
        echo "WARNING: D-${V} has only ${N_ROWS} trainer rows (<90% of 6,145) — budget-mismatched arm" | tee -a "${FAILLOG}"
    fi

    OUT="models/dose-${V}-6145"
    if [[ -e "${OUT}/final" ]]; then
        echo "== [${SECONDS}s] D-${V}: ${OUT}/final exists — skipping training =="
    else
        echo "== [${SECONDS}s] D-${V}: training at the EXACT controlled-experiment config =="
        # identical to train_controlled_exp.slurm / ctrl-llm-6145 except --train-file/--output-dir
        python scripts/train_invarembed.py \
            --train-file "data/llm_pairs_${V}/pairs.jsonl" --max-rows 6145 \
            --model Qwen/Qwen3-Embedding-0.6B \
            --model-dtype bfloat16 --bf16 \
            --loss cmnrl --batch-size 256 --mini-batch-size 16 --scale 20 \
            --epochs 3 --lr 2e-5 --warmup-ratio 0.05 --seed 42 \
            --dev-frac 0.05 --eval-steps 100 \
            --query-prompt-name query \
            --output-dir "${OUT}"
    fi

    for TIER in easy hard; do
        [[ -s "results/eval_${TIER}_dose-${V}.json" ]] && continue
        run_soft "D-${V}: eval tier=${TIER}" \
        python scripts/eval_retrieve.py --tier "${TIER}" --model "${OUT}/final" \
            --device cuda --model-dtype bfloat16 --query-prompt-name query \
            --batch-size 64 --max-seq-length 1024 \
            --emb-cache-dir .emb_cache \
            --output "results/eval_${TIER}_dose-${V}.json"
    done
    if [[ ! -s "results/crosslingual_dose-${V}.json" ]]; then
        run_soft "D-${V}: real-duplicate (cross-lingual) eval" \
        python scripts/eval_crosslingual.py --model "${OUT}/final" \
            --device cuda --model-dtype bfloat16 --query-prompt-name query \
            --max-seq-length 1024 \
            --output "results/crosslingual_dose-${V}.json"
    fi
done

# ---------------------------------------------------------------------------
# STAGE 3 — summary table: benchmark gain vs dose + pre-registration check
# ---------------------------------------------------------------------------
echo "=== [${SECONDS}s] DOSE-RESPONSE SUMMARY ==="
python - <<'PY'
import json, os

def r1(path, key):
    try:
        return json.load(open(path))[key]["recall@1"]
    except Exception:
        return None

def rows_negs(path):
    try:
        n = negs = 0
        for line in open(path):
            n += 1
            negs += len(json.loads(line).get("negatives") or [])
        return n, negs
    except Exception:
        return None, None

# (label, easy-json, hard-json, xling-json, trainer-file)
POINTS = [
    ("D1 exact (ctrl-llm-6145, ref)", "results/eval_easy_ctrl-llm.json",
     "results/eval_hard_ctrl-llm.json", "results/crosslingual_ctrl-llm-6145.json",
     "data/llm_pairs/pairs.jsonl"),
    ("D2 paraphrase", "results/eval_easy_dose-paraphrase.json",
     "results/eval_hard_dose-paraphrase.json", "results/crosslingual_dose-paraphrase.json",
     "data/llm_pairs_paraphrase/pairs.jsonl"),
    ("D3 style", "results/eval_easy_dose-style.json",
     "results/eval_hard_dose-style.json", "results/crosslingual_dose-style.json",
     "data/llm_pairs_style/pairs.jsonl"),
    ("D4 unrelated", "results/eval_easy_dose-unrelated.json",
     "results/eval_hard_dose-unrelated.json", "results/crosslingual_dose-unrelated.json",
     "data/llm_pairs_unrelated/pairs.jsonl"),
]
REFS = [
    ("ctrl-cas-6145 (verified ref)", "results/eval_easy_ctrl-cas.json",
     "results/eval_hard_ctrl-cas.json", "results/crosslingual_ctrl-cas-6145.json", None),
    ("base 0.6B untrained (ref)", "results/eval_easy_qwen3-0.6b-base.json",
     "results/eval_hard_qwen3-0.6b-base.json", "results/crosslingual_qwen3-0.6b-base.json", None),
]
# fallbacks = published campaign numbers (README) if a ref file is absent
be = r1("results/eval_easy_qwen3-0.6b-base.json", "overall");  be = 8.32 if be is None else be
bh = r1("results/eval_hard_qwen3-0.6b-base.json", "overall");  bh = 0.00 if bh is None else bh
bx = r1("results/crosslingual_qwen3-0.6b-base.json", "strict_crosslingual_gold")
bx = 84.73 if bx is None else bx

fmt = lambda v: "  --  " if v is None else f"{v:6.2f}"
print(f"{'dose point':34s} {'easyR@1':>7s} {'dEasy':>7s} {'hardR@1':>7s} {'dHard':>7s} "
      f"{'xlingR@1':>8s} {'rows':>5s} {'negs':>6s}")
table = {}
for label, fe, fh, fx, ftr in POINTS + REFS:
    e, h, x = r1(fe, "overall"), r1(fh, "overall"), r1(fx, "strict_crosslingual_gold")
    nr, ng = rows_negs(ftr) if ftr else (None, None)
    de = None if e is None else e - be
    dh = None if h is None else h - bh
    table[label.split()[0]] = dict(easy=e, hard=h, xling=x, de=de, dh=dh)
    print(f"{label:34s} {fmt(e)} {fmt(de)} {fmt(h)} {fmt(dh)} {fmt(x):>8s} "
          f"{nr if nr is not None else '--':>5} {ng if ng is not None else '--':>6}")
print(f"{'(base row = delta reference)':34s} {fmt(be)} {'':>7s} {fmt(bh)} {'':>7s} {fmt(bx):>8s}")

d = [table.get(k, {}) for k in ("D1", "D2", "D3", "D4")]
if all(p.get("hard") is not None for p in d):
    hard_d = [p["dh"] for p in d]
    easy_d = [p["de"] for p in d]
    xl     = [p["xling"] for p in d]
    mono = lambda s: all(a > b for a, b in zip(s, s[1:]))
    print("\n--- PRE-REGISTERED PREDICTION CHECK (see job-script header) ---")
    print(f"P-L1 hard-delta monotone D1>D2>D3>D4: {'PASS' if mono(hard_d) else 'FAIL'}  "
          f"({' > '.join(f'{v:.2f}' for v in hard_d)})")
    print(f"P-L1 easy-delta monotone D1>D2>D3>D4: {'PASS' if mono(easy_d) else 'FAIL'}  "
          f"({' > '.join(f'{v:.2f}' for v in easy_d)})")
    if all(v is not None for v in xl):
        spread = max(xl) - min(xl)
        p2 = spread <= 10.0 and all(v < bx for v in xl) and not mono(xl)
        print(f"P-L2 real-duplicate flat (spread<=10, all<base {bx:.2f}, no dose trend): "
              f"{'PASS' if p2 else 'FAIL'}  (spread {spread:.2f}, xling {xl})")
    else:
        print("P-L2: xling result(s) missing — check failure log")
    falsifier = hard_d[3] >= 0.5 * hard_d[0]
    print(f"FALSIFIER (D4 hard delta >= 50% of D1's): "
          f"{'FIRED — recipe-proximity mechanism REFUTED' if falsifier else 'not fired'}  "
          f"(D4 {hard_d[3]:.2f} vs threshold {0.5 * hard_d[0]:.2f})")
    print("Reminder: D4 carries 0 attached negatives by design (see header) — "
          "report its numbers with that asymmetry attached.")
else:
    print("\nSummary incomplete — missing eval JSONs; see", os.environ.get("FAILLOG", "failure log"))
PY

echo "== failures logged (empty = clean): =="
cat "${FAILLOG}"
echo "== dose-response finished: $(date) =="
echo "== next: add a reproducibility.json entry from results/llm_pairs_{paraphrase,style,unrelated}_summary.json,"
echo "==       results/eval_{easy,hard}_dose-*.json and results/crosslingual_dose-*.json =="
